{
  "@var": {
    "prefix": [
      "svar"
    ],
    "body": [
      "/** @var $0 */"
    ],
    "description": "PHPDoc @var"
  },
  "@function": {
    "prefix": [
      "sfunc"
    ],
    "body": [
      "/**",
      " * $0",
      " * @param ${2:type} ${3:name}",
      " * @return ${1:void}",
      " */"
    ],
    "description": "PHPDoc function"
  },
  "foreach": {
    "prefix": [
      "sfe"
    ],
    "body": [
      "foreach (${1:list} as ${2:elem}) {",
      "\t$0",
      "}"
    ],
    "description": "foreach"
  },
  "sql-block": {
    "prefix": [
      "ssql"
    ],
    "body": [
      "<<<SQL",
      "\t$0",
      "SQL"
    ],
    "description": "Multiline SQL block"
  },
  "html-block": {
    "prefix": [
      "shtml"
    ],
    "body": [
      "<<<HTML",
      "\t$0",
      "HTML"
    ],
    "description": "Multiline HTML block"
  }
}